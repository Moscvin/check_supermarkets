{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supermarket-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supermarket",
      // înlocuiește cu id-ul afișat de: npx wrangler d1 create supermarket
      "database_id": "e405903d-5500-4389-aaf3-3ce8b8c9183c"
    }
  ],
  "vars": {
    // Gemini nativ (gratuit; cheia de la aistudio.google.com merge în x-goog-api-key); modelul e în URL.
    // Pentru Grok: LLM_API_URL=https://api.x.ai/v1/chat/completions, LLM_MODEL=grok-4.20-0309-non-reasoning
    "LLM_API_URL": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
    "LLM_MODEL": "gemini-3.5-flash-lite"
  }
  // Secrete (npx wrangler secret put <NUME>): TELEGRAM_BOT_TOKEN, TELEGRAM_SECRET, LLM_API_KEY
}
